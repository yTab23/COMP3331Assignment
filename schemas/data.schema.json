{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "items": {
      "type": "object",
      "properties": {
        "sample": {
          "type": "integer",
          "minimum": 1
        },
        "temperature_c": {
          "type": "number"
        }
      },
      "required": [
        "sample",
        "temperature_c"
      ],
      "additionalProperties": false
    }
  }
}
